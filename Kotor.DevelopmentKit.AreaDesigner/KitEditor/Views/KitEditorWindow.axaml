<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kotor.DevelopmentKit.AreaDesigner.KitEditor.ViewModels"
        xmlns:hooks="using:Kotor.DevelopmentKit.AreaDesigner.KitEditor.ViewModels.Hooks"
        xmlns:templates="using:Kotor.DevelopmentKit.AreaDesigner.KitEditor.ViewModels.Templates"
        xmlns:core="using:Kotor.DevelopmentKit.Base.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Kotor.DevelopmentKit.AreaDesigner.KitEditor.Views.KitEditorWindow"
        x:DataType="vm:KitEditorViewModel"
        Title="KitEditorWindow">
    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="WorldObjectListResource" x:DataType="vm:WorldObjectItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                <TextBlock Text="{Binding TemplateID}" FontSize="10" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="WorldObjectPanelResource" x:DataType="vm:WorldObjectItem">
            <StackPanel HorizontalAlignment="Stretch">
                <ComboBox ItemsSource="{Binding WorldObjectTypes}"
                          ItemTemplate="{StaticResource WorldObjectTypeComboResource}"
                          SelectedItem="{Binding Type, Mode=TwoWay}" />
                <core:LabeledTextBox Label="Kit ID" Text="{Binding KitID}" Grid.Row="0" />
                <core:LabeledTextBox Label="Template ID" Text="{Binding TemplateID}" Grid.Row="1" />
                <core:LabeledTextBox Label="Class ID" Text="{Binding ClassID}" Grid.Row="2" />
                <core:LabeledTextBox Label="Name" Text="{Binding Name}" Grid.Row="3" />
                <core:LabeledTextBox Label="Model" Text="{Binding Model}" />
                
                <StackPanel>
                    <TextBlock Text="Magnets" />
                    <ListBox ItemTemplate="{StaticResource MagnetListResource}"
                             ItemsSource="{Binding Magnets}"
                             SelectedItem="{Binding SelectedMagnet}"
                             Height="100" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Add" Command="{Binding AddMagnet}" />
                        <Button Content="Remove" Command="{Binding DeleteSelectedMagnet}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="MagnetPanelResource" DataType="vm:MagnetItem">
            <StackPanel>
                <core:LabeledTextBox Label="Kit ID" Text="{Binding KitID}" />
                <core:LabeledTextBox Label="Template ID" Text="{Binding TemplateID}" />
                <core:Vector3Edit Label="Position" Value="{Binding Position}" />
                <core:QuaternionEdit Label="Orientation" Value="{Binding Orientation}" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="MagnetListResource" x:DataType="vm:MagnetItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="WorldObjectTypeComboResource" x:DataType="vm:WorldObjectTypeItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl>
        <TabItem Header="Kit">
            <StackPanel>
                <core:LabeledTextBox Label="Name" Text="{Binding Name}" />
                <core:LabeledTextBox Label="ID" Text="{Binding KitID}" IsReadOnly="True" />
                <core:LabeledTextBox Label="Version" Text="{Binding Version}" IsReadOnly="True" />
                <core:LabeledTextBox Label="FilePath" Text="{Binding FilePath}" IsReadOnly="True" />
                <Button Content="Save" Command="{Binding Save}" />
                <Button Content="Save As" Command="{Binding SaveAs}" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Objects">
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="5">

                <Border Grid.Column="0" Padding="4" Background="#ddd">
                    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="5" Background="#bbb">
                        <ComboBox ItemTemplate="{StaticResource WorldObjectTypeComboResource}"
                                  ItemsSource="{Binding WorldObjectTypeItems}"
                                  SelectedItem="{Binding SelectedWorldObjectType, Mode=TwoWay}"
                                  Grid.Row="0" />
                        <ListBox ItemTemplate="{StaticResource WorldObjectListResource}"
                                 ItemsSource="{Binding ObjectTemplateItems}"
                                 SelectedItem="{Binding SelectedWorldObject}"
                                 Grid.Row="1"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    Grid.Row="2">
                            <Button Content="Import" Command="{Binding ImportTemplates}" />
                            <Button Content="Add" Command="{Binding AddTemplate}" />
                            <Button Content="Delete" Command="{Binding DeleteSelectedTemplate}" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Column="1" Padding="5" Background="#ddd">
                    <Border Padding="5" Background="#bbb">
                        <ContentControl Content="{Binding SelectedWorldObject}" Grid.Row="4">
                            <ContentControl.DataTemplates>
                                <StaticResource ResourceKey="WorldObjectPanelResource" />
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Border>
                </Border>

                <Border Grid.Column="2" Padding="5" Background="#ddd">
                    <StackPanel Spacing="5">
                        <Border Padding="5" Background="#bbb">
                            <ContentControl Content="{Binding SelectedWorldObject.SelectedMagnet}">
                                <ContentControl.DataTemplates>
                                    <StaticResource ResourceKey="MagnetPanelResource" />
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
