<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kotor.DevelopmentKit.AreaDesigner.KitEditor.ViewModels"
        xmlns:core="using:Kotor.DevelopmentKit.Base.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Kotor.DevelopmentKit.AreaDesigner.KitEditor.Views.KitEditorWindow"
        x:DataType="vm:KitEditorViewModel"
        Title="KitEditorWindow">
    <Window.Styles>
        <!--Tab Control Styles-->
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="ObjectItemList" x:DataType="vm:ObjectItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                <TextBlock Text="{Binding TemplateID}" FontSize="10" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="ObjectItemPanel" x:DataType="vm:ObjectItem">
            <StackPanel>
                <core:LabeledTextBox Label="Model" Text="{Binding Model}" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="WalltemPanel" x:DataType="vm:WallItem">
            <StackPanel>
                <core:LabeledTextBox Label="Model" Text="{Binding Model}" />
                <core:LabeledTextBox Label="Doorframe Template ID" Text="{Binding DoorFrameID}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DoorframeItemPanel" x:DataType="vm:DoorFrameItem">
            <StackPanel>
                <core:LabeledTextBox Label="Model" Text="{Binding Model}" />
                
                <StackPanel>
                    <TextBlock Text="Wall Hooks" />
                    <ListBox ItemTemplate="{StaticResource HookItem}"
                                ItemsSource="{Binding Hooks}"
                                SelectedItem="{Binding SelectedHook}"
                                Height="100" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--<Button Content="Add" Command="{Binding TileTab.AddWallHook}" />
                        <Button Content="Remove" Command="{Binding TileTab.DeleteSelectedWallHook}" />-->
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileItemPanel" x:DataType="vm:TileItem">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="Magnets" />
                    <ListBox ItemTemplate="{StaticResource WallHookItemTemplate}"
                             ItemsSource="{Binding Hooks}"
                             SelectedItem="{Binding SelectedHook}"
                             Height="100" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--<Button Content="Add" Command="{Binding AddWallHook}" />-->
                        <!--<Button Content="Remove" Command="{Binding DeleteSelectedWallHook}" />-->
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="WallHookItemPanel" DataType="vm:WallHookItem">
            <StackPanel>
                <core:LabeledTextBox Label="Default Wall ID" Text="{Binding DefaultTemplateID}" />
                <core:Vector3Edit Label="Position" Value="{Binding Position}" />
                <core:QuaternionEdit Label="Orientation" Value="{Binding Orientation}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CornerHookPanel" DataType="vm:CornerHookItem">
            <StackPanel>
                <core:LabeledTextBox Label="Inner Corner Kit ID" Text="{Binding DefaultInnerKitID}" />
                <core:LabeledTextBox Label="Inner Corner Templat ID" Text="{Binding DefaultInnerTemplateID}" />
                <core:LabeledTextBox Label="Outer Corner Kit ID" Text="{Binding DefaultOuterKitID}" />
                <core:LabeledTextBox Label="Outer Corner Template ID" Text="{Binding DefaultOuterTemplateID}" />
                <core:Vector3Edit Label="Position" Value="{Binding Position}" />
                <core:QuaternionEdit Label="Orientation" Value="{Binding Orientation}" />
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate x:Key="WorldObjectTypeItemTemplate" x:DataType="vm:WorldObjectTypeItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl>
        <TabItem Header="Kit">
            <StackPanel>
                <core:LabeledTextBox Label="Name" Text="{Binding Name}" />
                <core:LabeledTextBox Label="ID" Text="{Binding KitID}" IsReadOnly="True" />
                <core:LabeledTextBox Label="Version" Text="{Binding Version}" IsReadOnly="True" />
                <core:LabeledTextBox Label="FilePath" Text="{Binding FilePath}" IsReadOnly="True" />
                <Button Content="Save" Command="{Binding Save}" />
                <Button Content="Save As" Command="{Binding SaveAs}" />
            </StackPanel>
        </TabItem>

        <TabItem Header="Objects">
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="5">

                <Border Grid.Column="0" Padding="4" Background="#ddd">
                    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="5" Background="#bbb">
                        <ComboBox ItemTemplate="{StaticResource WorldObjectTypeItemTemplate}"
                                  ItemsSource="{Binding WorldObjectTypeItems}"
                                  SelectedItem="{Binding SelectedWorldObjectTypeItem, Mode=TwoWay}" />
                        <ListBox ItemTemplate="{StaticResource ObjectItemList}"
                                 ItemsSource="{Binding ObjectTemplateItems}"
                                 SelectedItem="{Binding SelectedObjectTemplateItem}"
                                 Grid.Row="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Grid.Row="2">
                            <DropDownButton Content="Add">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Object" Command="{Binding AddBasicWorldObject}" />
                                        <MenuItem Header="Tile" Command="{Binding AddTileWorldObject}" />
                                        <MenuItem Header="Floor" Command="{Binding AddFloorWorldObject}" />
                                        <MenuItem Header="Ceiling" Command="{Binding AddCeilingWorldObject}" />
                                        <MenuItem Header="Wall" Command="{Binding AddWallWorldObject}" />
                                        <MenuItem Header="Doorframe" Command="{Binding AddDoorframeWorldObject}" />
                                        <MenuItem Header="InnerCorner" Command="{Binding AddInnerCornerWorldObject}" />
                                        <MenuItem Header="OuterCorner" Command="{Binding AddOuterCornerWorldObject}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Content="Delete" Command="{Binding DeleteSelectedObject}" />
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Column="1" Padding="5" Background="#ddd">
                    <StackPanel Spacing="5">
                        <Border Padding="5" Background="#bbb">
                            <StackPanel HorizontalAlignment="Left">
                                <core:LabeledTextBox Label="Kit ID" Text="{Binding SelectedObjectTemplateItem.KitID}" />
                                <core:LabeledTextBox Label="Template ID" Text="{Binding SelectedObjectTemplateItem.TemplateID}" />
                                <core:LabeledTextBox Label="Class ID" Text="{Binding SelectedObjectTemplateItem.ClassID}" />
                                <core:LabeledTextBox Label="Name" Text="{Binding SelectedObjectTemplateItem.Name}" />
                                                     
                                <ContentControl Content="{Binding SelectedObjectTemplateItem}">
                                    <ContentControl.DataTemplates>
                                        <StaticResource ResourceKey="TileItemPanel" />
                                        <StaticResource ResourceKey="ObjectItemPanel" />
                                        <StaticResource ResourceKey="WalltemPanel" />
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="5" Background="#ddd">
                    <StackPanel Spacing="5">
                        <Border Padding="5" Background="#bbb">
                            <StackPanel HorizontalAlignment="Left">
                                
                            <!--    <ContentControl Content="{Binding SelectedObjectTemplateItem}">
                                    <ContentControl.DataTemplates>
                                        <DataTemplate x:DataType="vm:TileItem">
                                            <ContentControl Content="{Binding SelectedHook}">
                                                <ContentControl.DataTemplates>
                                                    <StaticResource ResourceKey="WallHookItemPanel" />
                                                </ContentControl.DataTemplates>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ContentControl.DataTemplates>
                                </ContentControl>-->
                                <ContentControl Content="{Binding SelectedObjectTemplateItem.SelectedHook}">
                                    <ContentControl.DataTemplates>
                                        <StaticResource ResourceKey="WallHookItemPanel" />
                                        <StaticResource ResourceKey="CornerHookPanel" />
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
