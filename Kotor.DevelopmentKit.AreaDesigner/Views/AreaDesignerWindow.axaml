<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kotor.DevelopmentKit.AreaDesigner.ViewModels"
        xmlns:mode="using:Kotor.DevelopmentKit.AreaDesigner.relocate.Mode"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Kotor.DevelopmentKit.AreaDesigner.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Name="Window"
        x:Class="Kotor.DevelopmentKit.AreaDesigner.Views.AreaDesignerWindow"
        x:DataType="vm:AreaDesignerViewModel"
        Title="Area Designer">

    <Design.DataContext>
        <vm:AreaDesignerViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="SelectFloorMode" x:DataType="mode:SelectFloorMode">
			<ListBox ItemsSource="{Binding FloorTemplates}"
                     SelectedItem="{Binding SelectedFloorTemplate}"
                     Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
		</DataTemplate>

	</Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewArea}" />
                <MenuItem Header="_Load" Command="{Binding LoadArea}" />
                <MenuItem Header="_Save" />
                <MenuItem Header="_Save As" Command="{Binding SaveAreaAs}" />
                <Separator/>
                <MenuItem Header="_Settings" Command="{Binding EditSettings}" />
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding #Window.OpenKitEditor}" />
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_To KotOR 1" Command="{Binding ExportK1}" />
                <MenuItem Header="_To KotOR 2" Command="{Binding ExportK2}" />
            </MenuItem>
            <MenuItem Header="_Advanced">
                <MenuItem Header="_Edit Kit" Command="{Binding #Window.OpenKitEditor}" />
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Label Content="Tile:" VerticalAlignment="Center" />
            <Button Content="Select" IsEnabled="{Binding !IsMode_SelectTile}" />
            <Button Content="Add" Command="{Binding SetSceneMode_AddTile}" IsEnabled="{Binding !IsMode_AddTile}" />
            
            <Label Content="Wall:" VerticalAlignment="Center" />
            <Button Content="Select" Command="{Binding SetSceneMode_SelectWall}" IsEnabled="{Binding !IsMode_SelectWall}" />
            
            <Label Content="Floor:" VerticalAlignment="Center" />
            <Button Content="Select" Command="{Binding SetSceneMode_SelectFloor}" IsEnabled="{Binding !IsMode_SelectFloor}" />
            
            <Label Content="Ceiling:" VerticalAlignment="Center" />
            <Button Content="Select" IsEnabled="{Binding !IsMode_SelectCeiling}" />

            <Label Content="Object:" VerticalAlignment="Center" />
            <Button Content="Select" Command="{Binding SetSceneMode_SelectObject}" IsEnabled="{Binding !IsMode_SelectObject}" />
            <Button Content="Add" Command="{Binding SetSceneMode_AddObject}" IsEnabled="{Binding !IsMode_AddObject}" />

            <DropDownButton Content="Visibility">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Show Walls" ToggleType="CheckBox" IsChecked="{Binding ShowWalls}" />
                        <MenuItem Header="Show Doors" ToggleType="CheckBox" IsChecked="{Binding ShowWalls}" />
                        <MenuItem Header="Show Corners" ToggleType="CheckBox" IsChecked="{Binding ShowWalls}" />
                        <MenuItem Header="Show Ceilings" ToggleType="CheckBox" IsChecked="{Binding ShowWalls}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

        </StackPanel>
        <StackPanel DockPanel.Dock="Left"
                    Width="250">
            <Grid ColumnDefinitions="*">
                <ComboBox ItemsSource="{Binding Kits}"
                          SelectedItem="{Binding SelectedKit}"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ContentControl Content="{Binding Mode}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type mode:AddTileMode}">
                        <ListBox ItemsSource="{Binding TileTemplates}"
                                 SelectedItem="{Binding SelectedTileTemplate}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type mode:SelectWallMode}">
                        <ListBox ItemsSource="{Binding WallTemplates}"
                                 SelectedItem="{Binding SelectedWallTemplate}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type mode:AddObjectMode}">
                        <ListBox ItemsSource="{Binding ObjectTemplates}"
                                 SelectedItem="{Binding SelectedObjectTemplate}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type mode:SelectObjectMode}">
                        <ListBox ItemsSource="{Binding ObjectTemplates}"
                                 SelectedItem="{Binding SelectedObjectTemplate}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DataTemplate>

                    <StaticResource ResourceKey="SelectFloorMode" />
                </ContentControl.DataTemplates>
            </ContentControl>
            
        </StackPanel>

        <local:SceneControl/>
    </DockPanel>

</Window>
