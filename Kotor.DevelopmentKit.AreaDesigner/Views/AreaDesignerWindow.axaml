<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kotor.DevelopmentKit.AreaDesigner.ViewModels"
        xmlns:mode="using:Kotor.DevelopmentKit.AreaDesigner.relocate.Mode"
        xmlns:active="using:Kotor.DevelopmentKit.AreaDesigner.relocate.Mode.Active"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:Kotor.DevelopmentKit.AreaDesigner.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Name="Window"
        x:Class="Kotor.DevelopmentKit.AreaDesigner.Views.AreaDesignerWindow"
        x:DataType="vm:AreaDesignerViewModel"
        Title="Area Designer">

    <Design.DataContext>
        <vm:AreaDesignerViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="AddTileMode" x:DataType="mode:AddTileMode">
			<ListBox ItemsSource="{Binding TileTemplates}"
                     SelectedItem="{Binding SelectedTileTemplate}"
                     Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
		</DataTemplate>
        
        <DataTemplate x:Key="AddObjectMode" x:DataType="mode:AddObjectMode">
			<ListBox ItemsSource="{Binding ObjectTemplates}"
                     SelectedItem="{Binding SelectedObjectTemplate}"
                     Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
		</DataTemplate>

        <DataTemplate x:Key="SelectObjectMode" x:DataType="mode:SelectObjectMode">
			<ListBox ItemsSource="{Binding ObjectTemplates}"
                     SelectedItem="{Binding SelectedObjectTemplate}"
                     Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
		</DataTemplate>
	</Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewArea}" />
                <MenuItem Header="_Load" Command="{Binding LoadArea}" />
                <MenuItem Header="_Save" />
                <MenuItem Header="_Save As" Command="{Binding SaveAreaAs}" />
                <Separator/>
                <MenuItem Header="_Settings" Command="{Binding EditSettings}" />
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding #Window.OpenKitEditor}" />
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_To KotOR 1" Command="{Binding ExportK1}" />
                <MenuItem Header="_To KotOR 2" Command="{Binding ExportK2}" />
            </MenuItem>
            <MenuItem Header="_Advanced">
                <MenuItem Header="_Edit Kit" Command="{Binding #Window.OpenKitEditor}" />
            </MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal">
            <Button Content="Select" Command="{Binding SetSceneMode_SelectObject}" IsEnabled="{Binding !IsMode_SelectObject}" />
            <Button Content="Add Tile" Command="{Binding SetSceneMode_AddTile}" IsEnabled="{Binding !IsMode_AddTile}" />
            <Button Content="Add Object" Command="{Binding SetSceneMode_AddObject}" IsEnabled="{Binding !IsMode_AddObject}" />

            <DropDownButton Content="Visibility">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Show Walls" ToggleType="CheckBox" IsChecked="{Binding ShowWalls, Mode=TwoWay}" />
                        <MenuItem Header="Show Doors" ToggleType="CheckBox" IsChecked="{Binding ShowDoors, Mode=TwoWay}" />
                        <MenuItem Header="Show Corners" ToggleType="CheckBox" IsChecked="{Binding ShowCorners, Mode=TwoWay}" />
                        <MenuItem Header="Show Ceilings" ToggleType="CheckBox" IsChecked="{Binding ShowCeilings, Mode=TwoWay}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

        </StackPanel>
        <StackPanel DockPanel.Dock="Left"
                    Width="250">
            <Grid ColumnDefinitions="*">
                <ComboBox ItemsSource="{Binding Kits}"
                          SelectedItem="{Binding SelectedKit}"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <ContentControl Content="{Binding Mode}">
                <ContentControl.DataTemplates>
                    <StaticResource ResourceKey="AddTileMode" />
                    <StaticResource ResourceKey="AddObjectMode" />
                    <StaticResource ResourceKey="SelectObjectMode" />
                </ContentControl.DataTemplates>
            </ContentControl>
            
        </StackPanel>

        <local:SceneControl KeyDown="SceneControl_KeyDown" />
    </DockPanel>

</Window>
